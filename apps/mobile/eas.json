{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://haven-eta-gray.vercel.app",
        "HAVEN_IOS_BUNDLE_ID": "app.haven.mobile.steven",
        "HAVEN_APPLE_TEAM_ID": "8FAR23849B"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6834916439",
        "appleTeamId": "8FAR23849B"
      }
    }
  }
}
