# Copia este archivo a apps/mobile/.env y ajusta el valor.
# Expo incrusta las variables EXPO_PUBLIC_* en la app al compilar el bundle:
# no pongas secretos aquí y reinicia Metro (`pnpm start -c`) después de cambiarlas.

# Dirección de Tierra (la web de apps/web) con la que la app se enlaza por defecto.
# Solo es el valor inicial: al unirse a una misión por QR o código, la app guarda
# la dirección de la invitación, y también se puede cambiar en Ajustes.
#
#   Despliegue en Vercel:   https://haven-eta-gray.vercel.app
#   Simulador de iOS:       http://localhost:3000
#   Emulador de Android:    http://10.0.2.2:3000
#   Teléfono físico:        http://<IP de tu Mac en la red local>:3000
EXPO_PUBLIC_API_URL=https://haven-eta-gray.vercel.app
