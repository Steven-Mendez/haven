# Copia este archivo a .env (está en .gitignore).
# Las variables EXPO_PUBLIC_* se incrustan en el bundle de la app: NO pongas secretos aquí.
# La app nunca habla con Mongo directamente; solo con la API de Next.js.

# URL base de la API (apps/web). Elige una:
# Simulador iOS:
EXPO_PUBLIC_API_URL=http://localhost:3000
# iPhone físico en la misma red (IP LAN de tu Mac):
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
# Producción (deploy en Vercel):
# EXPO_PUBLIC_API_URL=https://<tu-proyecto>.vercel.app
