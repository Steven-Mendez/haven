# Atlas (las mismas variables que tiene el proyecto en Vercel)
MONGODB_USERNAME="<usuario>"
MONGODB_PASSWORD="<password>"
MONGODB_URI="mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net"
MONGODB_DB=haven

# Local (Docker): `pnpm db:up` y MONGODB_USE_LOCAL=true
MONGODB_USE_LOCAL=false
MONGODB_LOCAL_URI=mongodb://localhost:27017

# Opcional: dirección de Tierra que va en el QR de invitación.
# Sin ella se usa el host de la página (en Vercel, el dominio del despliegue).
# HAVEN_PUBLIC_URL=https://<tu-proyecto>.vercel.app
