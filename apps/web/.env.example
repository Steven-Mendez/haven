# Copia este archivo a apps/web/.env.local y rellena los valores.
# En Vercel se configuran las mismas variables en Settings → Environment Variables.

# --- MongoDB Atlas (obligatorio) -------------------------------------------
# Cadena de conexión del clúster: Atlas → Connect → Drivers.
# Si la contraseña tiene caracteres especiales, codifícalos (p. ej. @ → %40).
MONGODB_URI="mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Nombre de la base de datos. Por defecto: haven
MONGODB_DB=haven

# --- MongoDB local con Docker (opcional, para trabajar sin internet) -------
# Con true se ignora MONGODB_URI y se usa MONGODB_LOCAL_URI. Levántalo con `pnpm db:up`.
# No lo actives en Vercel.
MONGODB_USE_LOCAL=false
MONGODB_LOCAL_URI=mongodb://localhost:27017

# --- Invitaciones por QR (opcional) ----------------------------------------
# Dirección de Tierra que se escribe en el QR que escanea el teléfono.
# Sin ella se usa el host desde el que se abre la página; si es localhost,
# la IP de esta máquina en la red local.
# HAVEN_PUBLIC_URL=https://haven-eta-gray.vercel.app
