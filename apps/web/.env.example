# Copia este archivo a .env.local (está en .gitignore; nunca subas el real).
# En Vercel estas mismas variables se configuran en Project Settings → Environment Variables.

# Requerida: sin ella el servidor lanza un error al arrancar (src/lib/mongodb.ts).
# Local con Docker (`pnpm db:up`):
MONGODB_URI=mongodb://localhost:27017
# MongoDB Atlas (necesario para Vercel; en Network Access permite 0.0.0.0/0):
# MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Opcional: si no se define, se usa "haven".
MONGODB_DB=haven
