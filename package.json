{
  "name": "haven",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "ios": "pnpm --filter mobile ios",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "pnpm -r --no-bail lint",
    "check:contract": "node scripts/check-watch-contract.mjs",
    "check": "pnpm check:contract && pnpm typecheck && pnpm lint"
  },
  "packageManager": "pnpm@12.18.0"
}
